{
  "rules": {
    ".read": false,
    ".write": false,
    "partyAccess": {
      "$partyId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('creatorUid').val() === auth.uid",
        ".validate": "newData.hasChildren(['creatorUid', 'passwordHash', 'passwordSalt', 'createdAt'])",
        "creatorUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "passwordHash": {
          ".validate": "newData.isString() && newData.val().length === 44"
        },
        "passwordSalt": {
          ".validate": "newData.isString() && newData.val().length === 24"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 1000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "parties": {
      "$partyId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && !data.exists() && newData.child('createdBy').val() === auth.uid && newData.child('members').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['name', 'createdBy', 'createdAt', 'members'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "createdBy": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 1000"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('partyAccess').child($partyId).exists()",
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "tasks": {
          ".indexOn": ["createdAt"],
          "$taskId": {
            ".write": "auth != null && root.child('parties').child($partyId).child('members').child(auth.uid).exists() && ((!data.exists() && newData.child('createdBy').val() === auth.uid) || (data.exists() && (!newData.exists() || (newData.child('id').val() === data.child('id').val() && newData.child('createdBy').val() === data.child('createdBy').val() && newData.child('createdAt').val() === data.child('createdAt').val()))))",
            ".validate": "!newData.exists() || (newData.hasChildren(['id', 'text', 'completed', 'createdBy', 'createdByName', 'createdAt', 'completedBy', 'completedByName', 'completedAt']) && newData.child('id').val() === $taskId && ((!newData.child('completed').val() && newData.child('completedBy').val() === '' && newData.child('completedByName').val() === '' && newData.child('completedAt').val() === 0) || (newData.child('completed').val() && newData.child('completedBy').val().length > 0 && newData.child('completedByName').val().length > 0 && newData.child('completedAt').val() > 0)))",
            "id": {
              ".validate": "newData.isString() && newData.val() === $taskId"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180"
            },
            "completed": {
              ".validate": "newData.isBoolean()"
            },
            "createdBy": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            },
            "createdByName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000"
            },
            "completedBy": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "completedByName": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "completedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "activity": {
          ".indexOn": ["timestamp"],
          "$activityId": {
            ".write": "auth != null && root.child('parties').child($partyId).child('members').child(auth.uid).exists() && !data.exists() && newData.child('userId').val() === auth.uid",
            ".validate": "newData.hasChildren(['type', 'userId', 'userName', 'taskText', 'timestamp'])",
            "type": {
              ".validate": "newData.isString() && (newData.val() === 'created-party' || newData.val() === 'joined' || newData.val() === 'left' || newData.val() === 'added' || newData.val() === 'completed' || newData.val() === 'reopened' || newData.val() === 'edited' || newData.val() === 'deleted')"
            },
            "userId": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "userName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "taskText": {
              ".validate": "newData.isString() && newData.val().length <= 180"
            },
            "timestamp": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
